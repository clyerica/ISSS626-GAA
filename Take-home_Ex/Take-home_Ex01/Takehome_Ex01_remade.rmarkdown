                 color="black", 
                 fill="light blue") +
  labs(title = "Cafe density in Singapore's core central region",
       subtitle= "Many subzones have none to a few cafes. \nThere is one outlier subzone with 91 cafes per km sq (Cecil in Downtown core)",
      x = "Cafe density (per km sq)",
      y = "Frequency") +
